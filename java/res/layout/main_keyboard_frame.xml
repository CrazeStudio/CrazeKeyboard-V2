<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cboard_keyboard_panel"
    android:layout_gravity="bottom"
    android:orientation="vertical">

    <!-- CBoard utility toolbar. The suggestion row below stays independent so predictions
         keep their own breathing room, as in the supplied keyboard reference. -->
    <com.android.inputmethod.latin.CBoardToolbarView
        android:id="@+id/cboard_top_row"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <View
        android:id="@+id/cboard_toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <com.android.inputmethod.latin.suggestions.SuggestionStripView
        android:id="@+id/suggestion_strip_view"
        android:layoutDirection="ltr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/config_suggestions_strip_height"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        style="?attr/suggestionStripViewStyle" />

    <View
        android:id="@+id/cboard_suggestion_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <com.android.inputmethod.keyboard.MainKeyboardView
        android:id="@+id/keyboard_view"
        android:layoutDirection="ltr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false" />
</LinearLayout>
